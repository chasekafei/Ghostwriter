<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" type="text/css" href="{{asset "css/normalize.css"}}">

    <title>{{meta_title}}</title>

    {{ghost_head}}

    <link rel="stylesheet" type="text/css" href="{{asset "css/style.css"}}">
    <link rel="stylesheet" type="text/css" href="{{asset "css/sidebar.css"}}">

    <script>
        (function () {
            var path = location.pathname;
            if (path.indexOf('/page/') === 0 || location.hash === '#posts') {
                document.documentElement.classList.add('is-browse');
            }
        })();
    </script>
</head>
<body class="{{body_class}}">

    <div id="wrapper">
        <header class="site-header">
            <div class="container">
                <div class="site-title-wrapper">
                    {{#if @site.logo}}
                        <a class="site-logo" title="{{@site.title}}" href="{{@site.url}}"><img src="{{img_url @site.logo size="s"}}" alt="{{@site.title}}"></a>
                    {{else}}
                        <h1 class="site-title"><a class="js-show-latest" title="{{@site.title}}" href="{{@site.url}}">{{@site.title}}</a></h1>

                        <a class="button-square" href="{{@site.url}}/rss/" aria-label="RSS">{{> icon icon="rss"}}</a>
                    {{/if}}
                </div>

                <ul class="site-nav">
                    <li class="site-nav-item"><a class="js-show-latest" title="{{@site.title}}" href="{{@site.url}}">Latest Post</a></li>
                    <li class="site-nav-item"><a class="js-show-index" title="{{@site.title}}" href="{{@site.url}}/#posts">Browse Posts</a></li>

                    {{navigation}}

                    {{#if @site.logo}}
                        <li class="site-nav-item"><a href="{{@site.url}}/rss/">RSS</a></li>
                    {{/if}}

                    <li class="site-nav-item"><button class="site-nav-search" type="button" data-ghost-search>Search</button></li>
                </ul>
            </div>
        </header>

        <div id="ajax-container">
            {{{body}}}
        </div>
    </div>

    {{> sidebar}}

    <footer class="footer">
        <div class="container">
            <div class="site-title-wrapper">
                <h1 class="site-title"><a title="{{@site.title}}" href="{{@site.url}}">{{@site.title}}</a></h1>

                <a class="button-square button-jump-top js-jump-top" href="#" aria-label="Back to top">{{> icon icon="up"}}</a>
            </div>

            <p class="footer-copyright">&copy; {{date format="YYYY"}} {{@site.title}} / Published with <a href="https://ghost.org">Ghost</a> / <a href="https://github.com/chasekafei/Ghostwriter">Ghostwriter</a></p>
        </div>
    </footer>

    {{ghost_foot}}

    <script type="text/javascript" src="{{asset "js/theme.js"}}"></script>

</body>
</html>
