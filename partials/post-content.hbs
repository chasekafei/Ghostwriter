<article class="post-container {{post_class}}">
    <header class="post-header">
        <h1 class="post-title">{{title}}</h1>

        <p class="post-date">Published <time datetime="{{published_at}}">{{date format="MMMM Do YYYY"}}</time> <strong>by {{authors}}</strong></p>
    </header>

    <div class="post-content clearfix">
        {{#if feature_image}}
            <img class="post-featured-image"
                srcset="{{img_url feature_image size="s"}} 300w,
                        {{img_url feature_image size="m"}} 600w,
                        {{img_url feature_image size="l"}} 1000w,
                        {{img_url feature_image size="xl"}} 2000w"
                sizes="(max-width: 600px) 100vw, 809px"
                src="{{img_url feature_image size="l"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
        {{/if}}

        {{{content}}}
    </div>

    <footer class="post-footer clearfix">
        {{#if tags}}
            <p class="post-tags"><span>Tagged:</span> {{tags}}</p>
        {{/if}}

        <div class="share">
            <a class="icon-twitter" href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute="true"}}"
                onclick="window.open(this.href, 'twitter-share', 'width=550,height=235');return false;"
                aria-label="Twitter">
                {{> icon icon="twitter"}}
            </a>

            <a class="icon-facebook" href="https://www.facebook.com/sharer/sharer.php?u={{url absolute="true"}}"
                onclick="window.open(this.href, 'facebook-share','width=580,height=296');return false;"
                aria-label="Facebook">
                {{> icon icon="facebook"}}
            </a>
        </div>
    </footer>

    {{#match @custom.comment_system "Ghost"}}
    <div class="post-comments">
        {{comments}}
    </div>
    {{else match @custom.comment_system "Gitalk"}}
    {{#if @custom.gitalk_client_id}}
    {{#if @custom.gitalk_client_secret}}
    <div class="post-comments">
        <div id="gitalk-container"
            data-client-id="{{@custom.gitalk_client_id}}"
            data-client-secret="{{@custom.gitalk_client_secret}}"
            data-repo="{{@custom.gitalk_repo}}"
            data-owner="{{@custom.gitalk_owner}}"
            data-admin="{{@custom.gitalk_admin}}"
            data-thread-id="{{slug}}"
            data-thread-title="{{title}}"></div>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gitalk@1/dist/gitalk.css">
        <script src="https://cdn.jsdelivr.net/npm/gitalk@1/dist/gitalk.min.js"></script>
        <script>
            (function () {
                var el = document.getElementById('gitalk-container');
                if (!el || typeof Gitalk === 'undefined') {
                    return;
                }
                var gitalk = new Gitalk({
                    clientID: el.dataset.clientId,
                    clientSecret: el.dataset.clientSecret,
                    repo: el.dataset.repo,
                    owner: el.dataset.owner,
                    admin: [el.dataset.admin],
                    id: el.dataset.threadId,
                    title: el.dataset.threadTitle,
                    distractionFreeMode: false,
                    pagerDirection: 'first'
                });
                gitalk.render('gitalk-container');
            })();
        </script>
    </div>
    {{/if}}
    {{/if}}
    {{else match @custom.comment_system "Remark42"}}
    {{#if @custom.remark42_host}}
    {{#if @custom.remark42_site_id}}
    <div class="post-comments">
        <div id="remark42">评论加载中...</div>
        <script>
            var remark_config = {
                host: "{{@custom.remark42_host}}",
                site_id: "{{@custom.remark42_site_id}}",
                url: "{{url absolute="true"}}",
                locale: "zh",
                simple_view: {{#if @custom.remark42_simple_view}}true{{else}}false{{/if}},
                no_footer: true,
                custom_properties: {
                    "--font-family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', 'Microsoft YaHei', sans-serif",
                    "--primary-color": "240, 56, 56",
                    "--primary-brighter-color": "214, 42, 42",
                    "--primary-darker-color": "176, 32, 32",
                    "--color5": "#f0f0f0",
                    "--color4": "#fafafa",
                    "--color9": "#F03838",
                    "--color15": "#F03838",
                    "--color29": "#F03838",
                    "--color33": "#d42e2e",
                    "--line-color": "#e6e6e6"
                }
            };
        </script>
        <script>!function(e,n){for(var o=0;o<e.length;o++){var r=n.createElement("script"),d=n.head||n.body;r.type="module",r.async=!0,r.defer=!0,r.src=remark_config.host+"/web/"+e[o]+".mjs",d.appendChild(r)}}(remark_config.components||["embed"],document);</script>
    </div>
    {{/if}}
    {{/if}}
    {{/match}}
</article>
