<div class="sidebar-toggle" role="button" tabindex="0" aria-expanded="false" aria-label="Open sidebar">
	<div class="sidebar-toggle-line-wrap">
		<span class="sidebar-toggle-line sidebar-toggle-line-first"></span>
		<span class="sidebar-toggle-line sidebar-toggle-line-middle"></span>
		<span class="sidebar-toggle-line sidebar-toggle-line-last"></span>
	</div>
</div>

<div class="back-to-top js-jump-top" role="button" tabindex="0" aria-label="Back to top"></div>

<aside id="sidebar" class="sidebar">
	<div class="sidebar-inner">
		<section class="site-overview sidebar-panel sidebar-panel-active">
			<div class="site-author motion-element">
				{{#if @site.logo}}
					<img class="site-author-image" src="{{img_url @site.logo size="s"}}" alt="{{@site.title}}">
				{{/if}}
				<p class="site-author-name"><a href="{{@site.url}}">{{@site.title}}</a></p>
				<p class="site-description motion-element">{{@site.description}}</p>
			</div>

			<nav class="site-state motion-element">
				<div class="site-state-item site-state-posts">
					<a class="js-show-index" href="{{@site.url}}/#posts">
						<span class="site-state-item-count">{{#get "posts" limit="1"}}{{pagination.total}}{{/get}}</span>
						<span class="site-state-item-name">日志</span>
					</a>
				</div>

				<div class="site-state-item site-state-categories">
					<a href="#">
						<span class="site-state-item-count">？</span>
						<span class="site-state-item-name">分类</span>
					</a>
				</div>

				<div class="site-state-item site-state-tags">
					<a href="{{@site.url}}/tags/">
						<span class="site-state-item-count">{{#get "tags" limit="1"}}{{pagination.total}}{{/get}}</span>
						<span class="site-state-item-name">标签</span>
					</a>
				</div>
			</nav>

			<div class="feed-link motion-element">
				<a href="{{@site.url}}/rss/" rel="alternate">
					{{> icon icon="rss"}}
					RSS
				</a>
			</div>

			{{#if @custom.sidebar_twitter}}
				{{> sidebar-social}}
			{{else if @custom.sidebar_instagram}}
				{{> sidebar-social}}
			{{else if @custom.sidebar_weibo}}
				{{> sidebar-social}}
			{{else if @custom.sidebar_steam}}
				{{> sidebar-social}}
			{{/if}}

			{{#if @custom.sidebar_friends}}
				<div class="links-of-author motion-element">
					<p class="site-author-name">Friends</p>
					{{#foreach (split @custom.sidebar_friends separator=";;")}}
						{{#split this separator="|" as |pair|}}
							<span class="links-of-author-item">
								<a href="{{lookup pair 1}}" target="_blank" rel="noopener">{{lookup pair 0}}</a>
							</span>
						{{/split}}
					{{/foreach}}
				</div>
			{{/if}}

			{{#if @custom.sidebar_links}}
				<div class="links-of-author motion-element">
					<p class="site-author-name">Links</p>
					{{#foreach (split @custom.sidebar_links separator=";;")}}
						{{#split this separator="|" as |pair|}}
							<span class="links-of-author-item">
								<a href="{{lookup pair 1}}" target="_blank" rel="noopener">{{lookup pair 0}}</a>
							</span>
						{{/split}}
					{{/foreach}}
				</div>
			{{/if}}
		</section>
	</div>
</aside>
